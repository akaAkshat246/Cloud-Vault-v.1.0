# ==============================================================================
# CloudVault Backend Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# PostgreSQL 15+ Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=cloudvault
DB_PASSWORD=cloudvault_dev_password
DB_NAME=cloudvault_db
DB_SSL=false
DB_LOGGING=false

# AWS S3 / MinIO Storage Configuration
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=cloudvault-storage
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_EXPIRATION_SECONDS=900
S3_ABORT_INCOMPLETE_MULTIPART_DAYS=2

# Secrets (JWT placeholders for M3 Auth)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_prod_minimum_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_prod_minimum_32_characters_long

