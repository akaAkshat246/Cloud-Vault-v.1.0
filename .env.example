# ==============================================================================
# CloudVault — Environment Configuration Template
# COPY TO .env BEFORE RUNNING LOCALLY. NEVER COMMIT PRODUCTION SECRETS.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# PostgreSQL 15 Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=cloudvault
DB_PASSWORD=cloudvault_secret_dev_pass
DB_NAME=cloudvault_db

# JWT & Session Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_prod_32bytes_minimum!!
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_do_not_use_in_prod_32bytes!!
REFRESH_TOKEN_EXPIRY_DAYS=7

# AWS S3 / MinIO Object Storage
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=cloudvault-storage
S3_PRESIGNED_URL_EXPIRES_SECONDS=900

# Redis Cache / Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379

# Client-Side Cryptographic Parameters (Argon2id Baseline)
VITE_KDF_MEMORY_KIB=65536
VITE_KDF_ITERATIONS=3
VITE_KDF_PARALLELISM=1

